{
  "name": "customers",
  "rows_per_batch": 50,
  "columns": [
    { "name": "customer_id",  "type": "sequence", "start": 1000 },
    { "name": "customer_code","type": "template", "pattern": "CUST-{customer_id:07d}" },
    { "name": "first_name",   "type": "faker", "provider": "first_name" },
    { "name": "last_name",    "type": "faker", "provider": "last_name" },
    { "name": "email",        "type": "faker", "provider": "email", "unique": true },
    { "name": "phone",        "type": "faker", "provider": "phone_number", "null_ratio": 0.1 },
    { "name": "city",         "type": "faker", "provider": "city" },
    { "name": "segment",      "type": "choice", "values": ["Retail", "SMB", "Enterprise"], "weights": [70, 20, 10] },
    { "name": "date_of_birth","type": "faker", "provider": "date_of_birth", "args": { "minimum_age": 18, "maximum_age": 80 } },
    { "name": "is_active",    "type": "bool", "true_ratio": 0.9 },
    { "name": "created_at",   "type": "timestamp", "sorted": true },
    { "name": "batch_id",     "type": "batch", "field": "id" }
  ]
}
